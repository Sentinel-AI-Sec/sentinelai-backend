{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "SentinelAI": {
    "Models": {
      "//": "Never put API keys in this file - it is committed. Use user-secrets, environment variables, or appsettings.Development.json.",
