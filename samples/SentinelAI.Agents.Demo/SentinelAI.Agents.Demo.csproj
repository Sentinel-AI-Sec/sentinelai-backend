<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\SentinelAI.Domain\SentinelAI.Domain.csproj" />
    <ProjectReference Include="..\..\src\SentinelAI.Application\SentinelAI.Application.csproj" />
    <ProjectReference Include="..\..\src\SentinelAI.Infrastructure\SentinelAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- dev.json holds real keys and is git-ignored, so it may not exist. -->
    <None Update="dev.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="dev.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('dev.json')" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enables `dotnet user-secrets` for the four agent keys. -->
    <UserSecretsId>sentinelai-agents-sec02</UserSecretsId>
  </PropertyGroup>

</Project>
