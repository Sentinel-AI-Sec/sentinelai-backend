{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Snyk IaC",
          "rules": [
            { "id": "SNYK-CC-TF-1", "properties": { "cwe": ["CWE-284"] } },
            { "id": "SNYK-CC-TF-124", "properties": { "cwe": ["CWE-778"] } },
            { "id": "SNYK-CC-TF-4", "properties": { "cwe": ["CWE-311"] } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SNYK-CC-TF-1",
          "message": { "text": "IAM policy grants all privileges." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "terragoat/infra/iam.tf" },
                "region": { "startLine": 23 }
              }
            }
          ]
        },
        {
          "ruleId": "SNYK-CC-TF-124",
          "message": { "text": "S3 bucket does not have server access logging enabled." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "terragoat/infra/s3.tf" },
                "region": { "startLine": 1 }
              }
            }
          ]
        },
        {
          "ruleId": "SNYK-CC-TF-4",
          "message": { "text": "S3 bucket is not encrypted at rest." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "terragoat/infra/s3.tf" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
