<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sentinelai-benchmark</AssemblyName>
    <RootNamespace>SentinelAI.Benchmark</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scorer lives in Application, where it is unit-tested without a corpus. This project
         is only the reader and the printer. -->
    <ProjectReference Include="..\..\src\SentinelAI.Application\SentinelAI.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentinelAI.Application.Tests" />
  </ItemGroup>

</Project>
